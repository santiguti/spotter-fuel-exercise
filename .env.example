# Copy to .env and adjust. Every value below already has a working default,
# so the project runs with no .env at all.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Vehicle (fixed by the exercise)
FUEL_MPG=10
FUEL_RANGE_MILES=500

# How far off the route a station may sit and still count
CORRIDOR_MILES=10

# Free routing service, no API key required
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=20

# Map background tiles, fetched by the browser, so they cost the API nothing.
# Not openstreetmap.org (blocks third-party apps) and not CARTO (stamps "API KEY REQUIRED").
# Any raster provider works; note Esri orders the path {z}/{y}/{x}.
MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
