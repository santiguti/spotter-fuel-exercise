# Copy to .env and adjust. Every value below already has a working default,
# so the project runs with no .env at all.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Vehicle (fixed by the exercise)
FUEL_MPG=10
FUEL_RANGE_MILES=500

# How far off the route a station may sit and still count
CORRIDOR_MILES=10

# Free routing service, no API key required
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=20

# Map background tiles, fetched by the browser. Not openstreetmap.org: it blocks third-party
# apps from hotlinking its tiles. Any {s}/{z}/{x}/{y} raster provider works here.
MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png
MAP_TILE_SUBDOMAINS=abcd
